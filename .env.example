# Google Gemini API Key (kostenlos unter https://aistudio.google.com/app/apikey)
# Optional - die App funktioniert auch ohne Key mit intelligentem Echtdaten-Fallback
GEMINI_API_KEY=

# Hugging Face Access Token mit Schreibrechten (für automatisches Deployment via GitHub Actions)
HF_TOKEN=

# Lokaler Port (Standard: 7860 für Hugging Face Spaces Kompatibilität)
PORT=7860
