# Nur für lokale Läufe. In GitHub Actions als Repository-Secrets/-Variablen setzen,
# niemals mit NEXT_PUBLIC_-Präfix (würde im Browser-Bundle landen).

# Optional: Google Gemini API Key für KI-Berichtstexte (https://aistudio.google.com/app/apikey).
# Ohne Key werden Berichte rein datenbasiert erstellt.
GEMINI_API_KEY=
# Optional: Modell (Default gemini-2.5-flash, Fallback gemini-flash-latest)
GEMINI_MODEL=

# Hugging Face Fine-grained Token mit Schreibrecht NUR auf den Space (für scripts/deploy_hf.py)
HF_TOKEN=
HF_SPACE_ID=ecke1985/energy-trend-radar-agent

# Lokaler Port (Standard: 7860 für Hugging Face Spaces Kompatibilität)
PORT=7860
